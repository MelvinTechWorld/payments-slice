model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  name                 String
  createdAt            TimestamptzString               @default(now())
  sessions             Session[]
  verificationCodes    VerificationCode[]
  passwordResetTokens  PasswordResetToken[]
  subscription         Subscription?
  paymentEvents        PaymentEvent[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model VerificationCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  expiresAt   TimestamptzString
  lastSentAt  TimestamptzString @default(now())
  createdAt   TimestamptzString @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model RateLimit {
  key       String   @id
  points    Int      @default(1)
  expiresAt TimestamptzString
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String   // e.g., 'monthly', 'yearly'
  pendingPlanId        String?  // the plan it will switch to at period end
  status               String   // e.g., 'active', 'canceled', 'past_due'
  currentPeriodStart   TimestamptzString
  currentPeriodEnd     TimestamptzString
  cancelAtPeriodEnd    Boolean  @default(false)
  stripeCustomerId     String   
  stripeSubscriptionId String   @unique
  createdAt            TimestamptzString @default(now())
}

model PaymentEvent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeEventId   String?  @unique // Idempotency key for webhooks
  eventType       String   // 'INITIATION', 'VERIFICATION', 'FULFILLMENT', 'FAILURE'
  amount          Int      // minor units
  planId          String   // e.g., 'monthly', 'yearly'
  message         String?  // optional reason or error message
  createdAt       TimestamptzString @default(now())
}
