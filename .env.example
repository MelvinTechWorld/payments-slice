# .env.example
# Copy to .env and fill in real values BY HAND. Never let an agent write here.
# .env must be gitignored. Verify in a private browser window before submitting.

# ---- Database ----
# Local Postgres connection string, or your hosted provider's pooled URL.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ---- Session / crypto ----
# Random 32+ byte secret. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---- App ----
# Used for building links in emails (reset password, verification).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Email (Assessment 1) ----
# From your email provider's dashboard. Resend / Postmark / SES / etc.
EMAIL_API_KEY=""
EMAIL_FROM="noreply@example.com"

# ---- Payments (Assessment 2) ----
# TEST MODE keys only. From your provider's dashboard, test mode toggle on.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
# From the webhook endpoint settings page, NOT the API keys page.
STRIPE_WEBHOOK_SECRET=""

# ---- AI provider (Assessment 3) ----
# From the provider console. Typed by hand. Never generated by an agent.
AI_API_KEY=""
AI_API_KEY_SECONDARY=""

# ---- Object storage (Assessment 3) ----
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""